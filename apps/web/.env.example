# The only env file: copy to apps/web/.env.local and fill in. Nothing is read from the repo root.
NEON_AUTH_BASE_URL=
# 32+ chars: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
DATABASE_URL=
TINYFISH_API_KEY=
# Comma-separated emails allowed into /admin
OBSERVATORY_ADMIN_EMAILS=
# Enable only when Google is configured on this Neon Auth branch.
NEON_AUTH_GOOGLE_ENABLED=false
# Optional production cookie domain
NEON_AUTH_COOKIE_DOMAIN=
MAX_AGENT_RUNS=2
# Required in production when the Vercel cron calls /api/internal/hunts.
CRON_SECRET=
