# Optional root setup input. `npm run setup:env` fills missing app-local values.
# Existing app-local configuration remains authoritative.
NEON_AUTH_BASE_URL=
DATABASE_URL=
OBSERVATORY_ADMIN_EMAILS=
# Server-only key required on every /admin URL. Blank generates one during setup.
ADMIN_ACCESS_KEY=
# Leave blank to generate a cookie secret in apps/web/.env.local.
NEON_AUTH_COOKIE_SECRET=
# Copied only to apps/web/.env.local.
TINYFISH_API_KEY=
# Enable only when Google is configured on this Neon Auth branch.
NEON_AUTH_GOOGLE_ENABLED=false
